# =====================================================
# MEDICORE PROFESSIONAL SYSTEM - VARIABLES DE ENTORNO
# =====================================================
# Copiar como .env y poner las claves reales (.env no se sube a git).
# Si una API no tiene sus claves, ese módulo se desactiva solo.

# ---------- URL BASE DEL SISTEMA (sin / al final) ----------
APP_URL=http://localhost/MediCore_medicoAdmin

# ---------- BASE DE DATOS MYSQL ----------
# En XAMPP se queda así (localhost, root, sin password).
# En Railway poner los datos de su servicio de MySQL.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=MediCore_db

# ---------- GOOGLE OAUTH 2.0 (login institucional) ----------
# Crear credenciales en https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=${APP_URL}/oauth_callback.php

# ---------- GOOGLE CALENDAR API (sincronizar citas) ----------
# Usa las mismas credenciales OAuth de arriba con el scope de Calendar
GOOGLE_CALENDAR_ENABLED=false
GOOGLE_CALENDAR_ID=primary

# ---------- GOOGLE MAPS (módulo Ubicación) ----------
# Crear API key en https://console.cloud.google.com/google/maps-apis
# Habilitar "Maps Embed API"
GOOGLE_MAPS_API_KEY=

# ---------- OPENWEATHER (recomendaciones por clima) ----------
# Cuenta gratuita en https://openweathermap.org/api
OPENWEATHER_API_KEY=
OPENWEATHER_CIUDAD=Puebla,MX

# ---------- TWILIO (OTP / verificación por SMS) ----------
# Cuenta en https://www.twilio.com/console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
OTP_ENABLED=false

# ---------- SENDGRID (correos: recuperación, confirmaciones) ----------
# Cuenta gratuita (100 correos/día) en https://sendgrid.com
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=notificaciones@medicore.com
SENDGRID_FROM_NAME=MediCore Professional System

# ---------- GOOGLE GEMINI (asistente de medicamentos) ----------
# Llave gratuita en https://aistudio.google.com/apikey
# Sin llave el asistente solo muestra el texto de CIMA.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# ---------- NOTIFICACIONES PUSH (VAPID) ----------
# Generar con: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:notificaciones@medicore.com
# Opcional, token para el cron de recordatorios (api/push.php?accion=cron&token=...)
PUSH_CRON_TOKEN=
