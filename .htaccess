# =====================================================
# MEDICORE PROFESSIONAL SYSTEM
# CONFIGURACIÓN RAÍZ DE APACHE
# =====================================================

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Redirección a HTTPS, comentada porque en XAMPP no hay SSL y se queda en bucle.
    # Para usarla primero configurar SSL (SECURITY.md, sección 1) y reiniciar Apache.
    # RewriteCond %{HTTPS} off
    # RewriteCond %{HTTP_HOST} ^localhost [NC]
    # RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# Cabeceras de seguridad (respaldo de las que manda config.php)
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin"
</IfModule>

# Nunca listar el contenido de directorios sin index
Options -Indexes
